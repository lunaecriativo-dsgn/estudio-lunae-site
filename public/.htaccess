# .htaccess — Lunae Estúdio Criativo (Hostinger / LiteSpeed)
# Fica em public/ e vai para a raiz do site a cada build.
# Funciona junto com a pré-renderização (scripts/prerender.mjs).

Options -MultiViews
DirectorySlash Off
DirectoryIndex index.html
RewriteEngine On

# 1) Forçar HTTPS e domínio sem www (redirect permanente 301)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://lunaecriativo.com.br/$1 [L,R=301]

# 2) Remover barra final (/servicos/ -> /servicos)
RewriteRule ^(.+)/$ /$1 [L,R=301]

# 3) Arquivos que existem são servidos direto (robots.txt, sitemap.xml, llms.txt, imagens, JS)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 4) Páginas pré-renderizadas: /servicos/identidade-visual -> /servicos/identidade-visual/index.html
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# 5) Páginas de cases (ainda sem pré-renderização) abrem pelo app
RewriteRule ^projetos/ /index.html [L]

# 6) Qualquer outro endereço inexistente responde 404 de verdade
ErrorDocument 404 /404.html

# Cabeçalhos de segurança
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Cache longo para arquivos com hash do Vite e imagens
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
